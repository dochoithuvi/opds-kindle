+func catalogStorePath() string {
+	return filepath.Join(docDir, "OPDSLibrary", "catalogs.json")
+}
+func defaultStore() catalogStore {
+	return catalogStore{Selected: defaultCatalogID, Catalogs: []savedCatalog{}}
+}
+func cleanCatalogName(name string) string {
+	name = strings.TrimSpace(name)
+	if len([]rune(name)) > 48 {
+		r := []rune(name)
+		name = string(r[:48])
+	}
+	return name
+}
+func normalizeStore(s *catalogStore) {
+	if s.Catalogs == nil {
+		s.Catalogs = []savedCatalog{}
+	}
+	out := make([]savedCatalog, 0, len(s.Catalogs))
+	seen := map[string]bool{}
+	selectedOK := s.Selected == defaultCatalogID
+	for _, c := range s.Catalogs {
+		c.ID = strings.TrimSpace(c.ID)
+		c.Name = cleanCatalogName(c.Name)
+		c.URL = strings.TrimSpace(c.URL)
+		if c.ID == "" || c.ID == defaultCatalogID || seen[c.ID] || c.Name == "" {
+			continue
+		}
+		if _, err := validURL(c.URL); err != nil {
+			continue
+		}
+		seen[c.ID] = true
+		out = append(out, c)
+		if s.Selected == c.ID {
+			selectedOK = true
+		}
+	}
+	s.Catalogs = out
+	if !selectedOK {
+		s.Selected = defaultCatalogID
+	}
+}
+func readCatalogStoreUnlocked() catalogStore {
+	s := defaultStore()
+	b, err := os.ReadFile(catalogStorePath())
+	if err != nil {
+		return s
+	}
+	if json.Unmarshal(b, &s) != nil {
+		return defaultStore()
+	}
+	normalizeStore(&s)
+	return s
+}
+func writeCatalogStoreUnlocked(s catalogStore) error {
+	normalizeStore(&s)
+	dir := filepath.Dir(catalogStorePath())
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		return err
+	}
+	b, err := json.MarshalIndent(s, "", "  ")
+	if err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(dir, ".catalogs-*")
+	if err != nil {
+		return err
+	}
+	name := tmp.Name()
+	defer os.Remove(name)
+	_ = tmp.Chmod(0600)
+	if _, err = tmp.Write(append(b, '\n')); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err = tmp.Sync(); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err = tmp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(name, catalogStorePath())
+}
+func storeViews(s catalogStore) catalogsResponse {
+	views := []catalogView{{ID: defaultCatalogID, Name: defaultCatalogName, Builtin: true, Selected: s.Selected == defaultCatalogID}}
+	for _, c := range s.Catalogs {
+		views = append(views, catalogView{ID: c.ID, Name: c.Name, URL: c.URL, Selected: s.Selected == c.ID})
+	}
+	return catalogsResponse{Selected: s.Selected, Catalogs: views}
+}
+func findCatalogIndex(s catalogStore, id string) int {
+	for i, c := range s.Catalogs {
+		if c.ID == id {
+			return i
+		}
+	}
+	return -1
+}
+func resolveSourceURL(id string) (string, error) {
+	if id == "" || id == defaultCatalogID {
+		return defaultCatalogURL, nil
+	}
+	catalogMu.Lock()
+	defer catalogMu.Unlock()
+	s := readCatalogStoreUnlocked()
+	for _, c := range s.Catalogs {
+		if c.ID == id {
+			return c.URL, nil
+		}
+	}
+	return "", errors.New("catalog source not found")
+}
+func catalogsHandler(w http.ResponseWriter, r *http.Request) {
+	catalogMu.Lock()
+	defer catalogMu.Unlock()
+	s := readCatalogStoreUnlocked()
+	if r.Method == http.MethodGet {
+		jsonReply(w, 200, storeViews(s))
+		return
+	}
+	if r.Method != http.MethodPost || r.Header.Get("X-OPDS-Library") != "1" {
+		fail(w, 405, errors.New("GET or OPDS Library POST required"))
+		return
+	}
+	var in struct {
+		Action string `json:"action"`
+		ID     string `json:"id"`
+		Name   string `json:"name"`
+		URL    string `json:"url"`
+	}
+	if err := json.NewDecoder(io.LimitReader(r.Body, 16<<10)).Decode(&in); err != nil {
+		fail(w, 400, err)
+		return
+	}
+	in.Action = strings.ToLower(strings.TrimSpace(in.Action))
+	in.ID = strings.TrimSpace(in.ID)
+	in.Name = cleanCatalogName(in.Name)
+	in.URL = strings.TrimSpace(in.URL)
+	switch in.Action {
+	case "select":
+		if in.ID == defaultCatalogID {
+			s.Selected = defaultCatalogID
+		} else if findCatalogIndex(s, in.ID) >= 0 {
+			s.Selected = in.ID
+		} else {
+			fail(w, 404, errors.New("catalog source not found"))
+			return
+		}
+	case "add":
+		if in.Name == "" {
+			fail(w, 400, errors.New("catalog name is required"))
+			return
+		}
+		if _, err := validURL(in.URL); err != nil {
+			fail(w, 400, err)
+			return
+		}
+		h := sha256.Sum256([]byte(in.Name + "\x00" + in.URL + "\x00" + time.Now().UTC().String()))
+		id := "c-" + hex.EncodeToString(h[:6])
+		s.Catalogs = append(s.Catalogs, savedCatalog{ID: id, Name: in.Name, URL: in.URL})
+	case "update":
+		idx := findCatalogIndex(s, in.ID)
+		if idx < 0 {
+			fail(w, 404, errors.New("catalog source not found"))
+			return
+		}
+		if in.Name == "" {
+			fail(w, 400, errors.New("catalog name is required"))
+			return
+		}
+		if _, err := validURL(in.URL); err != nil {
+			fail(w, 400, err)
+			return
+		}
+		s.Catalogs[idx].Name = in.Name
+		s.Catalogs[idx].URL = in.URL
+	case "delete":
+		if in.ID == defaultCatalogID {
+			fail(w, 400, errors.New("default catalog cannot be deleted"))
+			return
+		}
+		idx := findCatalogIndex(s, in.ID)
+		if idx < 0 {
+			fail(w, 404, errors.New("catalog source not found"))
+			return
+		}
+		s.Catalogs = append(s.Catalogs[:idx], s.Catalogs[idx+1:]...)
+		if s.Selected == in.ID {
+			s.Selected = defaultCatalogID
+		}
+	default:
+		fail(w, 400, errors.New("unknown catalog action"))
+		return
+	}
+	if err := writeCatalogStoreUnlocked(s); err != nil {
+		fail(w, 500, err)
+		return
+	}
+	jsonReply(w, 200, storeViews(s))
+}
